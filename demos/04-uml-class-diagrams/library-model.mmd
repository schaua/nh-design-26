classDiagram
    direction LR
    class Member {
        -memberId String
        -unpaidFees double
        -activeLoans List~Loan~
        +canBorrow() boolean
        +payFees(amount double)
    }

    class Loan {
        -dueDate Date
        -returnDate Date
        +isOverdue() boolean
        +calculateLateFee() double
    }

    class Loanable {
        <<interface>>
        +calculateDuration() int
    }

    class Book {
        -isbn String
        -title String
    }

    class Library {
        +lendBook(member, book) Loan
        +returnBook(loan)
    }

    Member "1" *-- "*" Loan : has
    Loan "*" o--> "1" Book : refers to
    Library ..> Member : coordinates
    Library ..> Book : checks out
    Library ..> Loan : creates
    Book ..|> Loanable : implements
