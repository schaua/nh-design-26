%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    actor M as Member
    participant L as Library
    participant B as Book
    participant Loan as Loan

    M->>+L: borrowBook(member, book)
    note right of L: Library is now active
    L->>+B: checkAvailable()
    note right of B: Book is now active
    B-->>-L: true
    note right of L: Book becomes inactive
    L->>+Loan: new Loan(member, book, dueDate)
    note right of Loan: Loan is now active
    Loan-->>-L: loan
    note right of L: Loan becomes inactive
    L-->>-M: confirmation
    note right of M: Member receives result, Library becomes inactive
